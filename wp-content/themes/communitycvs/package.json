{
  "name": "communitycvs-theme",
  "version": "1.0.0",
  "description": "Custom WordPress theme for Community CVS",
  "main": "index.js",
  "scripts": {
    "build": "sass scss/main.scss css/main.css --style compressed",
    "watch:css": "sass --watch scss/main.scss:css/main.css --style expanded --poll",
    "watch:sync": "browser-sync start --proxy 'http://howardair.local/communitycvs/' --files 'css/main.css, **/*.php, js/*.js' --reload-debounce 500 --reload-delay 100 --no-notify --no-open",
    "watch": "concurrently \"npm run watch:css\" \"npm run watch:sync\""
  },
  "keywords": [
    "wordpress",
    "theme",
    "scss"
  ],
  "author": "Howard Marsden",
  "license": "ISC",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "sass": "^1.69.0"
  }
}
